# atf-eval configuration. Copy to `.env` (git-ignored) and fill in what you need:
#   cp .env.example .env
#
# atf-eval reads a `.env` from the current directory (then the repo root) at startup.
# A variable that is already exported in your shell always wins over the file.
# The deterministic metrics (NTS, STS, TIS, OS) need no key at all; only the LLM
# judges do (RS's routing judge and the Group 1-5 metrics). With no key they
# report N/A, never 0.

# ── LLM judge ────────────────────────────────────────────────────────────────
# Which provider judges: anthropic (default) | nvidia.  Same as --provider.
ATF_LLM_PROVIDER=anthropic

# Anthropic (default provider). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# NVIDIA NIM (OpenAI-compatible). Needs: pip install -e ".[nvidia]"
NVIDIA_API_KEY=
# Only for a self-hosted NIM; the default is https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=

# ── API server / client (atf-eval serve / atf-eval submit) ───────────────────
# Where the server stores goldens and evaluations (default: ./atf_server_data).
# ATF_SERVER_DATA=./atf_server_data
# The server `atf-eval submit` talks to (default: http://127.0.0.1:8000).
# ATF_SERVER=http://127.0.0.1:8000
# Judge keys above belong on the SERVER machine's .env; the agent side never needs them.

# ── LLM response cache ───────────────────────────────────────────────────────
# Judge calls are cached on disk by prompt, so re-running costs nothing.
# ATF_LLM_CACHE=on                 # on | off
# ATF_LLM_CACHE_DIR=.llm_cache
