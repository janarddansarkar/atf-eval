      },
      "output": {
        "agent": "Your latest bill is 89.50, which includes a one-off 40.00 roaming charge on top of your usual 49.50."
      },
      "nodes": [
        {
          "node_id": "identify_customer",
          "sequence": 1,
          "state_changes": [
            {
              "key": "authenticated",
              "old": false,
              "new": true
            }
          ],
          "tool_calls": [
            {
              "tool_id": "lookup_account",
              "sequence": 1,
              "input": {
                "account_id": "ACC-1002"
              },
              "status": "success"
            }
          ]
        },
        {
          "node_id": "classify_intent",
          "sequence": 2,
          "state_changes": [
            {
              "key": "intent",
              "old": null,
              "new": "billing"
            }
          ],
          "tool_calls": []
        },
        {
          "node_id": "billing_node",
          "sequence": 3,
          "state_changes": [],
          "tool_calls": [
            {
              "tool_id": "get_bill",
              "sequence": 1,
              "input": {
                "account_id": "ACC-1002"
              },
              "status": "success"
            }
          ]
        }
      ],
      "routing": {
        "path": "billing",
        "target": "self_service"
      }
    },
    {
