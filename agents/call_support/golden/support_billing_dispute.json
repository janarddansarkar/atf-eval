          "node_id": "classify_intent",
          "sequence": 1,
          "state_changes": [
            {
              "key": "intent",
              "old": "billing",
              "new": "escalate"
            }
          ],
          "tool_calls": []
        },
        {
          "node_id": "escalate_node",
          "sequence": 2,
          "state_changes": [
            {
              "key": "ticket_id",
              "old": null,
              "new": "TCK-1002-BIL"
            }
          ],
          "tool_calls": [
            {
              "tool_id": "create_ticket",
              "sequence": 1,
              "input": {
                "account_id": "ACC-1002",
